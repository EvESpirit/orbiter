#include <windows.h>
#include "Resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// --------------------------------------------------------------
// Launchpad Graphics Engine Discovery String Table
// Orbiter's DefVideoTab::ScanDir() loads each DLL in Modules\Plugin
// as a datafile and checks that string 1001 == "Graphics engines".
// --------------------------------------------------------------
STRINGTABLE
BEGIN
    IDS_INFO "Vulkan 1.3 Graphics Client (OVP-VK)\r\n\r\nNative Vulkan 1.3 rendering engine plugin for OpenOrbiter."
    IDS_TYPE "Graphics engines"
END

// --------------------------------------------------------------
// Advanced Vulkan Configuration Dialog
// --------------------------------------------------------------
IDD_VK_ADVANCED DIALOGEX 0, 0, 268, 206
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "VulkanClient Advanced Configuration"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Rendering & Filtering", IDC_STATIC, 8, 7, 252, 74
    LTEXT           "Anisotropic Filtering:", IDC_STATIC, 18, 24, 92, 10
    COMBOBOX        IDC_VK_ANISO, 128, 21, 120, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Anti-Aliasing (MSAA):", IDC_STATIC, 18, 43, 92, 10
    COMBOBOX        IDC_VK_MSAA, 128, 40, 120, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Enable planetary terrain flattening (.flt)", IDC_VK_FLATS,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 62, 220, 10

    GROUPBOX        "Timing & Diagnostics", IDC_STATIC, 8, 86, 252, 68
    CONTROL         "Enable frame-rate limiter (FPS):", IDC_VK_FPSLIMIT,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 102, 125, 10
    EDITTEXT        IDC_VK_FPSVAL, 152, 100, 96, 13, ES_AUTOHSCROLL
    LTEXT           "Debug Log Level:", IDC_STATIC, 18, 121, 92, 10
    COMBOBOX        IDC_VK_DBGLVL, 128, 118, 120, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Enable Khronos Vulkan Validation Layers", IDC_VK_VALIDATION,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 138, 220, 10

    LTEXT           "", IDC_VK_DEVINFO, 10, 160, 248, 18
    DEFPUSHBUTTON   "OK", IDOK, 152, 184, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 210, 184, 50, 14
END

// --------------------------------------------------------------
// Version Information
// --------------------------------------------------------------
1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "FileDescription", "Vulkan 1.3 Graphics Client for OpenOrbiter"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "VulkanClient"
            VALUE "OriginalFilename", "VulkanClient.dll"
            VALUE "ProductName", "OpenOrbiter VulkanClient (OVP-VK)"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
