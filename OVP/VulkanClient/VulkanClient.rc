#include <windows.h>
#include "Resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// DefVideoTab::ScanDir() requires string 1001 == "Graphics engines"
STRINGTABLE
BEGIN
    IDS_INFO "Vulkan 1.3 Graphics Client (OVP-VK)\r\n\r\nNative Vulkan 1.3 rendering engine plugin for OpenOrbiter."
    IDS_TYPE "Graphics engines"
END

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "FileDescription", "Vulkan 1.3 Graphics Client for OpenOrbiter"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "VulkanClient"
            VALUE "OriginalFilename", "VulkanClient.dll"
            VALUE "ProductName", "OpenOrbiter VulkanClient (OVP-VK)"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
